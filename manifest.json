{
  "manifest_version": 3,
  "name": "RoPilot",
  "version": "0.1.0",
  "description": "A multi-model development companion for Roblox Studio.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "RoPilot"
  },
  "background": {
    "service_worker": "background.js"
  }
}